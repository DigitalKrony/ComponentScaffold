{
  "name": "component_scaffold",
  "description": "Will build a folder and file structure that fits your requirements.",
  "version": "0.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://dev.azure.com/DesignFunedikly/OpenSource/_git/ComponentScaffold"
  },
  "author": {
    "name": "DigitalKrony",
    "email": "adam.sivins@gmail.com",
    "url": "http://funedikly.com"
  },
  "_npmUser": {
    "name": "DigitalKrony",
    "email": "adam.sivins@gmail.com"
  },
  "scripts": {
    "start:dev": "tsc -watch",
    "start:build": "tsc",
    "scaffold": "node ./bin/cli.js",
    "test": "cd ./test && scaffold",
    "snyk-protect": "snyk protect",
    "prepare": "npm run snyk-protect"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "latest",
    "chalk": "^5.6.0",
    "glob": "^11.0.3",
    "inquirer": "^12.9.4",
    "js-yaml": "^4.1.0",
    "prettier": "^3.6.2",
    "snyk": "^1.1299.0"
  },
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "require": "./lib/index.js",
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "files": [
    "./lib"
  ],
  "directories": {
    "bin": "./bin"
  },
  "bin": {
    "scaffold": "./bin/cli.js"
  },
  "keywords": [
    "scaffold",
    "cli",
    "react",
    "angular",
    "vue",
    "javascript"
  ],
  "readmeFilename": "README.md",
  "snyk": true,
  "packageManager": "yarn@4.9.3"
}
