{
  "compileOnSave": true,
  "outDir": "./lib",
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "./src",
    "composite": true,
    "listEmittedFiles": true,
    "module": "commonjs",
    "target": "es6",
    "lib": ["dom", "es2016"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": false,
    "checkJs": false,
    "strictPropertyInitialization": false,
    "removeComments": true,
    "importHelpers": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true
  },
  "exclude": ["node_modules", "lib", "lib-cjs"],
  "include": ["./src/**/*"],
}