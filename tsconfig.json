{
  "extends": "./config/typescript/tsconfig.json",
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "./src",
    "baseUrl": "./src/",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "typeRoots": ["node_modules/@types"],
  "include": ["./src/**/*", "./src/**/*.json"],
  "exclude": ["lib", "lib-cjs", "node_modules"]
}
